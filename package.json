{
  "name": "marksfin-api",
  "version": "0.1.0",
  "description": "MarksFin backend API (Marco 0 / Fundação)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:prod": "npm run build && pm2 startOrReload ecosystem.config.cjs",
    "restart:prod": "pm2 delete marksfin-api || true; npm run build && pm2 start ecosystem.config.cjs",
    "deploy": "npm run build && pm2 startOrReload ecosystem.config.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed-admin": "tsx src/database/seed-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "argon2": "^0.44.0",
    "dotenv": "^18.0.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "mariadb": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "pm2": "^7.0.3",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "argon2@0.44.0": true
  }
}
