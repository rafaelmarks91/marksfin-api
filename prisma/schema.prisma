// MarksFin API - Prisma schema (Marco 0 / Fundação)
// Datasource targets MySQL wire protocol; production database is MariaDB 11.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SpaceRole {
  OWNER
  VIEWER
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  INVESTMENT
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
}

/// A registered user. Email is normalized to lowercase before persisting.
model User {
  id           String     @id @db.Char(36)
  name         String     @db.VarChar(120)
  /// Normalized to lowercase before persisting (not enforced at the DB level).
  email        String     @unique @db.VarChar(190)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  spaceMemberships  SpaceMember[]
  sentInvitations   Invitation[]     @relation("InvitationInvitedBy")
  sessions          Session[]
  passwordResets    PasswordReset[]
  createdTransactions Transaction[]  @relation("TransactionCreatedBy")
  auditLogs         AuditLog[]       @relation("AuditLogActor")

  @@map("users")
}

model FinancialSpace {
  id        String   @id @db.Char(36)
  name      String   @db.VarChar(100)
  currency  String   @default("BRL") @db.Char(3)
  timezone  String   @default("America/Sao_Paulo") @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  members      SpaceMember[]
  invitations  Invitation[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  auditLogs    AuditLog[]

  @@map("financial_spaces")
}

model SpaceMember {
  id         String     @id @db.Char(36)
  spaceId    String     @map("space_id") @db.Char(36)
  userId     String     @map("user_id") @db.Char(36)
  role       SpaceRole
  joinedAt   DateTime   @default(now()) @map("joined_at") @db.DateTime(3)
  revokedAt  DateTime?  @map("revoked_at") @db.DateTime(3)

  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
  @@index([spaceId])
  @@map("space_members")
}

model Invitation {
  id         String     @id @db.Char(36)
  spaceId    String     @map("space_id") @db.Char(36)
  invitedBy  String     @map("invited_by") @db.Char(36)
  email      String     @db.VarChar(190)
  role       SpaceRole  @default(VIEWER)
  tokenHash  String     @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime   @map("expires_at") @db.DateTime(3)
  acceptedAt DateTime?  @map("accepted_at") @db.DateTime(3)
  revokedAt  DateTime?  @map("revoked_at") @db.DateTime(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.DateTime(3)

  space   FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  inviter User           @relation("InvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: Restrict)

  @@index([spaceId, email, revokedAt])
  @@map("invitations")
}

model Account {
  id                  String      @id @db.Char(36)
  spaceId             String      @map("space_id") @db.Char(36)
  name                String      @db.VarChar(100)
  type                AccountType
  initialBalance      Decimal     @map("initial_balance") @db.Decimal(15, 2)
  initialBalanceDate  DateTime    @map("initial_balance_date") @db.Date
  color               String?     @db.Char(7)
  isArchived          Boolean     @default(false) @map("is_archived")
  createdAt           DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  space        FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([spaceId, isArchived])
  @@map("accounts")
}

model Category {
  id         String       @id @db.Char(36)
  spaceId    String       @map("space_id") @db.Char(36)
  name       String       @db.VarChar(80)
  type       CategoryType
  icon       String?      @db.VarChar(40)
  color      String?      @db.Char(7)
  isArchived Boolean      @default(false) @map("is_archived")
  createdAt  DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  space        FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([spaceId, type, isArchived])
  @@map("categories")
}

model Transaction {
  id               String          @id @db.Char(36)
  spaceId          String          @map("space_id") @db.Char(36)
  accountId        String          @map("account_id") @db.Char(36)
  /// Null for transfer legs, which are not associated with a category.
  categoryId       String?         @map("category_id") @db.Char(36)
  type             TransactionType
  /// Always positive by convention; sign/direction is derived from `type`.
  amount           Decimal         @db.Decimal(15, 2)
  description      String          @db.VarChar(160)
  transactionDate  DateTime        @map("transaction_date") @db.Date
  notes            String?         @db.Text
  /// Links the two rows (TRANSFER_OUT/TRANSFER_IN) that make up one transfer.
  transferGroupId  String?         @map("transfer_group_id") @db.Char(36)
  createdBy        String          @map("created_by") @db.Char(36)
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  /// Soft delete marker.
  deletedAt        DateTime?       @map("deleted_at") @db.DateTime(3)

  space   FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  account Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  creator User           @relation("TransactionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([spaceId, transactionDate, id])
  @@index([accountId, transactionDate])
  @@index([categoryId, transactionDate])
  @@index([transferGroupId])
  @@map("transactions")
}

model Session {
  id          String    @id @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.DateTime(3)
  lastSeenAt  DateTime  @map("last_seen_at") @db.DateTime(3)
  ipHash      String?   @map("ip_hash") @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(255)
  revokedAt   DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  spaceId      String   @map("space_id") @db.Char(36)
  actorUserId  String   @map("actor_user_id") @db.Char(36)
  action       String   @db.VarChar(80)
  entityType   String   @map("entity_type") @db.VarChar(50)
  entityId     String   @map("entity_id") @db.Char(36)
  metadata     Json
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  actor User           @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([spaceId, createdAt])
  @@map("audit_logs")
}
