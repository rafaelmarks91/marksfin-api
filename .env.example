# Em produção use HOST=127.0.0.1 (API acessível só pelo Apache local via PM2,
# nunca exposta direto). No servidor compartilhado, teraodonto-api já usa a
# porta 3000 e teraodonto-site usa 3001 — o MarksFin usa 3333 para não colidir.
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
APP_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=marksfin
DB_PASSWORD=marksfin
DB_NAME=marksfin
DB_CONNECTION_LIMIT=10
SESSION_SECRET=change-me-to-a-long-random-value
INVITATION_TOKEN_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MarksFin <nao-responda@exemplo.com>
